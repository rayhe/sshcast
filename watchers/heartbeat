#!/usr/bin/env bash
# heartbeat - example sshcast producer: emits one JSON event every INTERVAL
# seconds. Useful for testing subscriptions end to end.
#
# Install: copy to ~/.sshcast-watchers/ on the remote host and chmod +x.
# Usage:   heartbeat [--since <id>] [--interval N]

INTERVAL=5
SINCE=""
while [ $# -gt 0 ]; do
    case "$1" in
        --since) SINCE="$2"; shift 2;;
        --interval) INTERVAL="$2"; shift 2;;
        *) shift;;
    esac
done

# --since is accepted for contract compatibility; a heartbeat has no history.
n=0
while true; do
    n=$((n+1))
    printf '{"id":"%s","ts":"%s","type":"heartbeat","seq":%d}\n' \
        "$(date +%s)-$n" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$n"
    sleep "$INTERVAL"
done
